# This is an exapmle .env
# Duplicate it and rename to .env-local in order to run the server.


# API remote URL. Comment it out if you want to use local server isntead.
REACT_APP_API=https://digital-carte.com:8800

# Uncomment the next line to use local server instead of remote one.
# REACT_APP_API=https://localhost:8800

# Media URL
REACT_APP_MEDIA=https://media.digital-carte.com

# Google API key
REACT_APP_GOOGLE_API=GoogleAPIKey_Goes_Here(ask_for_the_key)