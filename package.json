    "start": "node src/server/index.js",
    "client": "webpack-dev-server --mode development --devtool inline-source-map --history-api-fallback",
    "server": "nodemon src/server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "lint": "eslint --ext .jsx --ext .js ./src --fix",
    "stylelint": "stylelint ./src/client/**/*.js --fix",
    "migrate-create": "node-pg-migrate create session-megration --database-url-var HOST_DB_URL --migrations-dir ./src/server/migrations",
    "migrate-up": "node-pg-migrate up --database-url-var HOST_DB_URL --migrations-dir ./src/server/migrations",
